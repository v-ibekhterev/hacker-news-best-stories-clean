{
  "HackerNews": {
    "BaseUrl": "https://hacker-news.firebaseio.com/v0/",
    "RefreshInterval": "00:01:00",
    "RequestTimeout": "00:00:10",
    "InitialLoadWaitTimeout": "00:00:15",
    "MaxUpstreamConcurrency": 10,
    "MaximumStoryCount": 100,
    "UpdateBatchSize": 100,
    "ReconciliationInterval": "00:30:00",
    "StreamReconnectDelay": "00:00:05",
    "StreamIdleTimeout": "00:01:00"
  },
  "Exports": {
    "MaximumCount": 1000000,
    "MaximumActiveJobs": 10,
    "MaximumReservedRows": 2000000,
    "ChunkSize": 500,
    "MaximumPageSize": 1000,
    "MaximumResponseBytes": 1048576,
    "JobDeadline": "00:30:00",
    "Retention": "1.00:00:00",
    "TombstoneRetention": "1.00:00:00",
    "PollInterval": "00:00:05"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
